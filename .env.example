# Copia este archivo a .env.local y completa los datos de envío.
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_EMAIL=contacto@rutabar.cl
NEXT_PUBLIC_SITIO_URL=https://rutabar.cl

# Resend: crea una API key de envío y usa una dirección de un dominio verificado.
# Mantén estas variables solo en el servidor; nunca uses el prefijo NEXT_PUBLIC.
RESEND_API_KEY=
RESEND_FROM_EMAIL=RUTABAR <contacto@barrabar.cl>
RESEND_TO_EMAIL=contacto@barrabar.cl
